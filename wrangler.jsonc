{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-flow",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp/*"] },
  "ai": { "binding": "AI" },
  // 画面（Cloudflare）で足した変数を、デプロイで消さない
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-flow",
      "database_id": "bcec0d34-633d-44c4-8e3c-bb9efb96ce1c",
      "migrations_dir": "migrations"
    }
  ]
  // 秘密の値は wrangler secret put で設定する：
  //   GITHUB_TOKEN        … 読み取りだけの細かい権限のトークン（公開リポジトリなら省略可）
  //   GITHUB_WRITE_TOKEN  … 書き出し用（Contents と Pull requests の書き込み。PR を出すだけで、マージは人）
  //   MCP_TOKEN           … Claude のコネクタの合言葉
  //   ADMIN_TOKEN         … 画面から使うときの合言葉
}
