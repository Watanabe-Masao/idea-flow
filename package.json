{
  "name": "idea-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply idea-flow --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply idea-flow --local",
    "db:migrate": "wrangler d1 migrations apply idea-flow --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.168.0"
  }
}
